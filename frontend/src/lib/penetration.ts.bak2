// 穿透 / 跳弹 / 后效判定（公式负责物理规则 + 数据表负责差异化参数）
import type { Ammo, PostPenModel } from '../data/ammo';
import { VEHICLE, type Zone } from '../data/vehicle';
import { VEHICLE_3D } from '../data/vehicle3d';
import { computeBallistics, computeBallistics3D, type Vector3 } from './ballistics';
import { type PostEffectDetail, type SpallCone, type SplashZone, generateSpallCone, calculateOverpressure } from './chainReactions';

export interface PenetrationResult {
  distance: number;
  impactAngleDeg: number;     // 入射角（含装甲倾角）
  effectiveThickness: number; // 有效装甲厚度 mm
  shellPen: number;           // 该距离下弹丸穿深 mm
  penetrated: boolean;
  ricochet: boolean;
  missed: boolean;            // 命中载具之外（未命中任何模块/装甲）
  armorNeutralized: boolean;  // 反应装甲等使弹丸失效
  postPenDamage: number;      // 本发造成的损伤 0–100
  crewKilled: boolean;
  resultText: string;
  postEffectDetails?: PostEffectDetail; // 后效详情（连锁反应、破片锥、超压等）
}

// ─── 策略模式：后效计算接口 ───

export interface PostEffectContext {
  ammo: Ammo;
  zone: Zone;
  penetrated: boolean;
  adjacentZoneMap?: Map<string, string[]>; // 相邻分区映射，用于破片锥计算
}

export interface PostEffectResult {
  postPenDamage: number;
  crewKilled: boolean;
  postEffectDetails?: PostEffectDetail; // 后效详情
}

export interface PostEffectStrategy {
  compute(ctx: PostEffectContext): PostEffectResult;
}

// ─── 辅助：构建相邻分区映射 ───

export function buildAdjacentZoneMap(zones: Zone[]): Map<string, string[]> {
  const map = new Map<string, string[]>();
  for (const z of zones) {
    if (z.adjacentZones && z.adjacentZones.length > 0) {
      map.set(z.key, z.adjacentZones);
    }
  }
  return map;
}

// ─── 辅助：根据口径估算 TNT 装药量（kg）───

function estimateTntKg(ammo: Ammo): number {
  // 粗略估算：APHE 装药约为口径^3 * 0.0000003（88mm ≈ 0.2kg）
  // HE 装药约为口径^3 * 0.000005（88mm ≈ 3.4kg）
  const cal = ammo.caliber;
  if (ammo.postPen === 'blast') {
    return Math.pow(cal, 3) * 0.000005;
  }
  if (ammo.postPen === 'spall') {
    return Math.pow(cal, 3) * 0.0000003;
  }
  return 0;
}

// ─── 辅助：根据 3D 命中点查找最近的 3D 分区，返回其 id（与 2D zone key 一致）───

function findNearestZone3DKey(impactPoint: Vector3): string | undefined {
  let bestId: string | undefined;
  let bestDist = Infinity;
  for (const z of VEHICLE_3D.zones) {
    const pos = z.collision.position;
    const dx = impactPoint.x - pos[0];
    const dy = impactPoint.y - pos[1];
    const dz = impactPoint.z - pos[2];
    const d2 = dx * dx + dy * dy + dz * dz;
    if (d2 < bestDist) {
      bestDist = d2;
      bestId = z.id;
    }
  }
  return bestId;
}

// ─── 5 种弹种的后效策略实现 ───

/** AP：直接穿甲，命中模块/乘员直接损伤，极小破片锥 */
export class APStrategy implements PostEffectStrategy {
  compute(ctx: PostEffectContext): PostEffectResult {
    if (!ctx.penetrated) return { postPenDamage: 0, crewKilled: false };
    const { zone } = ctx;
    const postPenDamage = zone.category === 'crew' ? 100 : zone.category === 'module' ? 75 : 35;
    const crewKilled = zone.category === 'crew' && postPenDamage >= 80;

    // AP 后效：极小破片锥（直线穿透）
    const fragments = ctx.adjacentZoneMap
      ? generateSpallCone(zone.key, 10, 2, postPenDamage * 0.3, ctx.adjacentZoneMap)
      : [];
    const spallCone: SpallCone = { angleDeg: 10, fragmentCount: 2, fragments };

    return {
      postPenDamage, crewKilled,
      postEffectDetails: { spallCone },
    };
  }
}

/** APHE：击穿后炸药产生额外破片，后效更高，30-45°破片锥 */
export class APHEStrategy implements PostEffectStrategy {
  compute(ctx: PostEffectContext): PostEffectResult {
    if (!ctx.penetrated) return { postPenDamage: 0, crewKilled: false };
    const { zone, ammo } = ctx;
    const postPenDamage = zone.category === 'crew' ? 100 : zone.category === 'module' ? 90 : 45;
    const crewKilled = zone.category === 'crew' && postPenDamage >= 80;

    // APHE 后效：30-45° 破片锥
    const coneAngle = 30 + Math.random() * 15; // 30~45°
    const fragmentCount = Math.round(4 + Math.random() * 4); // 4~8 片
    const fragments = ctx.adjacentZoneMap
      ? generateSpallCone(zone.key, coneAngle, fragmentCount, postPenDamage * 0.5, ctx.adjacentZoneMap)
      : [];
    const spallCone: SpallCone = { angleDeg: Math.round(coneAngle), fragmentCount, fragments };

    // 如果装药 >= 170g TNT 当量，计算超压
    const tntKg = estimateTntKg(ammo);
    let overpressureKPa: number | undefined;
    if (tntKg >= 0.17) {
      const opResult = calculateOverpressure(tntKg, 1.5); // 假设车内 1.5m 距离
      overpressureKPa = opResult.overpressureKPa;
    }

    return {
      postPenDamage, crewKilled,
      postEffectDetails: { spallCone, overpressureKPa },
    };
  }
}

/** HEAT：成型装药，窄锥高温射流，对间隙装甲后效大幅降低 */
export class HEATStrategy implements PostEffectStrategy {
  compute(ctx: PostEffectContext): PostEffectResult {
    if (!ctx.penetrated) return { postPenDamage: 0, crewKilled: false };
    const { zone } = ctx;
    let d = zone.category === 'crew' ? 95 : zone.category === 'module' ? 70 : 40;
    if (zone.armorType === 'spaced') d = Math.round(d * 0.4);
    const crewKilled = zone.category === 'crew' && d >= 80;

    // HEAT 后效：窄锥射流（15°），高温射流碎片
    const fragments = ctx.adjacentZoneMap
      ? generateSpallCone(zone.key, 15, 5, d * 0.6, ctx.adjacentZoneMap)
      : [];
    const spallCone: SpallCone = { angleDeg: 15, fragmentCount: 5, fragments };

    return {
      postPenDamage: d, crewKilled,
      postEffectDetails: { spallCone },
    };
  }
}

/** APCR：穿深高但后效弱，极小破片锥 */
export class APCRStrategy implements PostEffectStrategy {
  compute(ctx: PostEffectContext): PostEffectResult {
    if (!ctx.penetrated) return { postPenDamage: 0, crewKilled: false };
    const { zone } = ctx;
    const postPenDamage = zone.category === 'crew' ? 80 : zone.category === 'module' ? 40 : 20;
    const crewKilled = zone.category === 'crew' && postPenDamage >= 80;

    // APCR 后效：极小破片锥（5°），极少碎片
    const fragments = ctx.adjacentZoneMap
      ? generateSpallCone(zone.key, 5, 1, postPenDamage * 0.15, ctx.adjacentZoneMap)
      : [];
    const spallCone: SpallCone = { angleDeg: 5, fragmentCount: 1, fragments };

    return {
      postPenDamage, crewKilled,
      postEffectDetails: { spallCone },
    };
  }
}

/** HE：不需击穿，命中即爆破；全向爆炸 + 超压 + 破片溅射 */
export class HEStrategy implements PostEffectStrategy {
  compute(ctx: PostEffectContext): PostEffectResult {
    const { zone, ammo } = ctx;
    let postPenDamage: number;
    let crewKilled: boolean;

    if (zone.category === 'crew') {
      postPenDamage = 90; crewKilled = true;
    } else if (zone.category === 'module') {
      postPenDamage = zone.armorType === 'RHA' && zone.nominalThickness <= 30 ? 70 : 40;
      crewKilled = false;
    } else {
      postPenDamage = 20; crewKilled = false;
    }

    // HE 后效：全向爆炸
    const tntKg = estimateTntKg(ammo);

    // 超压计算（假设车内 2m 距离）
    const opResult = calculateOverpressure(tntKg, 2.0);

    // 全向破片溅射（360°）
    const fragments = ctx.adjacentZoneMap
      ? generateSpallCone(zone.key, 360, 10, postPenDamage * 0.6, ctx.adjacentZoneMap)
      : [];
    const spallCone: SpallCone = { angleDeg: 360, fragmentCount: 10, fragments };

    // 溅射区域：相邻分区列表
    const splashZones: SplashZone[] = [];
    if (ctx.adjacentZoneMap) {
      const neighbors = ctx.adjacentZoneMap.get(zone.key) ?? [];
      for (const nk of neighbors) {
        splashZones.push({ zoneKey: nk, damage: Math.round(postPenDamage * 0.4), distance: 1.0 });
      }
    }

    return {
      postPenDamage, crewKilled,
      postEffectDetails: {
        spallCone,
        overpressureKPa: opResult.overpressureKPa,
        splashZones,
      },
    };
  }
}

// 策略注册表
const POST_EFFECT_STRATEGIES: Record<PostPenModel, PostEffectStrategy> = {
  direct: new APStrategy(),
  spall: new APHEStrategy(),
  jet: new HEATStrategy(),
  weak: new APCRStrategy(),
  blast: new HEStrategy(),
};

function getPostEffectStrategy(postPen: PostPenModel): PostEffectStrategy {
  return POST_EFFECT_STRATEGIES[postPen];
}

// 弹丸在给定距离下的穿深（对 penCurve 线性插值）
export function penAt(ammo: Ammo, dist: number): number {
  const curve = ammo.penCurve;
  if (curve.length === 0) return 0;
  if (dist <= curve[0].dist) return curve[0].pen;
  if (dist >= curve[curve.length - 1].dist) return curve[curve.length - 1].pen;
  for (let i = 0; i < curve.length - 1; i++) {
    const a = curve[i];
    const b = curve[i + 1];
    if (dist >= a.dist && dist <= b.dist) {
      const r = (dist - a.dist) / (b.dist - a.dist);
      return a.pen + r * (b.pen - a.pen);
    }
  }
  return curve[curve.length - 1].pen;
}

// 单次命中评估
export function evaluateHit(opts: {
  ammo: Ammo;
  zone: Zone | null;
  distance: number;
}): PenetrationResult {
  const { ammo, zone, distance } = opts;

  const ball = computeBallistics({
    distance,
    muzzleVelocity: ammo.muzzleVelocity,
    ballisticCoefficient: ammo.ballisticCoefficient,
  });

  if (!zone) {
    return {
      distance,
      impactAngleDeg: ball.impactAngleDeg,
      effectiveThickness: 0,
      shellPen: penAt(ammo, distance),
      penetrated: false,
      ricochet: false,
      missed: true,
      armorNeutralized: false,
      postPenDamage: 0,
      crewKilled: false,
      resultText: '未命中载具（射偏）',
    };
  }

  // 入射角 = 弹道俯角 + 装甲板倾角
  const impactAngle = ball.impactAngleDeg + zone.slope;
  // 转正：弹种可将入射角“压平”一定度数
  const theta = Math.max(0, impactAngle - ammo.normalization);
  const cosT = Math.cos((theta * Math.PI) / 180);

  // 边界：入射角接近 90°（平行于装甲表面）-> 必然跳弹/未击穿
  if (cosT < 0.01) {
    return {
      distance,
      impactAngleDeg: impactAngle,
      effectiveThickness: zone.nominalThickness / 0.01,
      shellPen: penAt(ammo, distance),
      penetrated: false,
      ricochet: true,
      missed: false,
      armorNeutralized: false,
      postPenDamage: 0,
      crewKilled: false,
      resultText: `入射角 ${impactAngle.toFixed(0)}° 过大，弹丸跳弹`,
    };
  }

  const effectiveThickness = zone.nominalThickness / cosT;
  let shellPen = penAt(ammo, distance);
  let armorNeutralized = false;
  let ricochet = false;
  let penetrated = false;

  // 装甲类型修正
  if (zone.armorType === 'ERA') {
    if (ammo.postPen === 'jet') {
      // 反应装甲完全化解破甲弹金属射流
      armorNeutralized = true;
      penetrated = false;
      return {
        distance,
        impactAngleDeg: impactAngle,
        effectiveThickness,
        shellPen,
        penetrated: false,
        ricochet: false,
        missed: false,
        armorNeutralized: true,
        postPenDamage: 0,
        crewKilled: false,
        resultText: `命中反应装甲(ERA)，${ammo.name} 金属射流被引爆失效`,
      };
    } else {
      // 反应装甲对动能弹削减约 30% 穿深
      shellPen *= 0.7;
    }
  } else if (zone.armorType === 'composite') {
    if (ammo.postPen === 'jet') shellPen *= 0.85; // 复合装甲削弱破甲
    else shellPen *= 0.95;
  }

  // 穿透 / 跳弹判定（符合 WT 语义：角度超阈值先跳弹，HE 除外）
  if (ammo.postPen === 'blast') {
    // 高爆弹无需击穿：命中即引爆，造成爆破/破片伤害
    penetrated = true;
  } else if (impactAngle > ammo.ricochetThreshold) {
    ricochet = true;
  } else if (shellPen >= effectiveThickness) {
    penetrated = true;
  }

  // 后效伤害（通过策略模式计算）
  let postPenDamage = 0;
  let crewKilled = false;
  let postEffectDetails: PostEffectDetail | undefined;
  if (ammo.postPen === 'blast' || penetrated) {
    const adjacentZoneMap = buildAdjacentZoneMap(VEHICLE.zones);
    const strategy = getPostEffectStrategy(ammo.postPen);
    const effect = strategy.compute({ ammo, zone, penetrated: true, adjacentZoneMap });
    postPenDamage = effect.postPenDamage;
    crewKilled = effect.crewKilled;
    postEffectDetails = effect.postEffectDetails;
  }

  const resultText = buildResultText(ammo, zone, distance, impactAngle, effectiveThickness, shellPen, penetrated, ricochet, armorNeutralized, postPenDamage, crewKilled);

  return {
    distance,
    impactAngleDeg: impactAngle,
    effectiveThickness,
    shellPen,
    penetrated,
    ricochet,
    missed: false,
    armorNeutralized,
    postPenDamage,
    crewKilled,
    resultText,
    postEffectDetails,
  };
}

function buildResultText(
  ammo: Ammo,
  zone: Zone,
  distance: number,
  impactAngle: number,
  eff: number,
  pen: number,
  penetrated: boolean,
  ricochet: boolean,
  neutralized: boolean,
  dmg: number,
  killed: boolean,
): string {
  const head = `${ammo.caliber}mm ${ammo.name} 于 ${distance}m，入射角 ${impactAngle.toFixed(0)}°，有效装甲 ${eff.toFixed(0)}mm / 穿深 ${pen.toFixed(0)}mm`;
  if (neutralized) return head + ' → 反应装甲化解';
  if (ricochet) return head + ' → 跳弹（未击穿）';
  const verb = penetrated ? '击穿' : '未击穿';
  const tail = zone.category === 'crew' && killed ? `，击毁${zone.label}` : `，${zone.label}受损 ${dmg}%`;
  return head + ` → ${verb}${tail}`;
}

// ─── 3D 命中评估 ───

export interface Armor3D {
  nominalThickness: number; // 标称厚度 mm
  normalVector: Vector3;    // 装甲表面法向量（单位向量）
  armorType: 'RHA' | 'spaced' | 'composite' | 'ERA';
  category: 'armor' | 'module' | 'crew';
  label: string;
}

export interface PenetrationResult3D extends PenetrationResult {
  impactPoint3D: Vector3;          // 3D命中点
  normalVector: Vector3;           // 命中点法向量
  trueIncidentAngleDeg: number;    // 真实3D入射角（由法向量点积计算）
  ricochetDirection: Vector3 | null; // 3D反弹方向向量
}

// 向量工具函数
function vec3Dot(a: Vector3, b: Vector3): number {
  return a.x * b.x + a.y * b.y + a.z * b.z;
}

function vec3Normalize(v: Vector3): Vector3 {
  const len = Math.sqrt(v.x * v.x + v.y * v.y + v.z * v.z);
  if (len < 1e-9) return { x: 0, y: 0, z: 1 };
  return { x: v.x / len, y: v.y / len, z: v.z / len };
}

function vec3Subtract(a: Vector3, b: Vector3): Vector3 {
  return { x: a.x - b.x, y: a.y - b.y, z: a.z - b.z };
}

function vec3Scale(v: Vector3, s: number): Vector3 {
  return { x: v.x * s, y: v.y * s, z: v.z * s };
}

function vec3Add(a: Vector3, b: Vector3): Vector3 {
  return { x: a.x + b.x, y: a.y + b.y, z: a.z + b.z };
}

/**
 * 3D命中评估：支持3D法向量入射，用向量点积计算真实入射角
 */
export function evaluateHit3D(opts: {
  ammo: Ammo;
  armor: Armor3D | null;
  impactPoint: Vector3;     // 3D命中点
  shotDirection: Vector3;   // 弹丸飞行方向（单位向量）
  distance: number;
}): PenetrationResult3D {
  const { ammo, armor, impactPoint, shotDirection, distance } = opts;

  // 计算3D弹道
  const ball3D = computeBallistics3D({
    muzzleVelocity: ammo.muzzleVelocity,
    caliber: ammo.caliber,
    ballisticCoefficient: ammo.ballisticCoefficient,
    distance,
    angle: 0, // 默认水平射击，实际角度由 shot_direction 决定
  });

  if (!armor) {
    return {
      distance,
      impactAngleDeg: ball3D.impactAngleDeg,
      effectiveThickness: 0,
      shellPen: penAt(ammo, distance),
      penetrated: false,
      ricochet: false,
      missed: true,
      armorNeutralized: false,
      postPenDamage: 0,
      crewKilled: false,
      resultText: '未命中载具（射偏）',
      impactPoint3D: impactPoint,
      normalVector: { x: 0, y: 0, z: 1 },
      trueIncidentAngleDeg: 0,
      ricochetDirection: null,
    };
  }

  // 3D入射角计算：用弹丸方向与法向量的点积
  const shotDir = vec3Normalize(shotDirection);
  const normal = vec3Normalize(armor.normalVector);

  // 弹丸与法线夹角 = arccos(|dot(shotDir, normal)|)
  // 夹角=0° 表示垂直命中（弹丸沿法线方向）
  // 夹角=90° 表示擦过命中（弹丸平行于装甲表面）
  const dotProduct = Math.abs(vec3Dot(shotDir, normal));
  const angleWithNormalRad = Math.acos(Math.min(1, dotProduct));
  const angleWithNormalDeg = (angleWithNormalRad * 180) / Math.PI;

  // 擦过角（与装甲表面的夹角）= 90° - 与法线夹角
  // 擦过角=0° → 平行于表面（擦过）
  // 擦过角=90° → 垂直于表面（垂直命中）
  const trueIncidentAngleDeg = 90 - angleWithNormalDeg;

  // 用于装甲计算的入射角 = 与法线夹角（等同于2D模型中的 impactAngle）
  // 垂直命中时接近0°，擦过命中时接近90°
  const normalAngleDeg = angleWithNormalDeg;

  // 转正
  const theta = Math.max(0, normalAngleDeg - ammo.normalization);
  const cosT = Math.cos((theta * Math.PI) / 180);

  // 边界：入射角接近 90°（平行于装甲表面）
  if (cosT < 0.01) {
    // 反弹方向 = 弹丸方向减去法线分量（关于表面的镜像）
    const dn = vec3Dot(shotDir, normal);
    const ricochetDir = vec3Normalize(
      vec3Subtract(shotDir, vec3Scale(normal, dn))
    );
    return {
      distance,
      impactAngleDeg: normalAngleDeg,
      effectiveThickness: armor.nominalThickness / 0.01,
      shellPen: penAt(ammo, distance),
      penetrated: false,
      ricochet: true,
      missed: false,
      armorNeutralized: false,
      postPenDamage: 0,
      crewKilled: false,
      resultText: `入射角 ${normalAngleDeg.toFixed(0)}° 过大，弹丸跳弹`,
      impactPoint3D: impactPoint,
      normalVector: normal,
      trueIncidentAngleDeg,
      ricochetDirection: ricochetDir,
    };
  }

  const effectiveThickness = armor.nominalThickness / cosT;
  let shellPen = penAt(ammo, distance);
  let armorNeutralized = false;
  let ricochet = false;
  let penetrated = false;

  // 装甲类型修正
  if (armor.armorType === 'ERA') {
    if (ammo.postPen === 'jet') {
      armorNeutralized = true;
      penetrated = false;
      return {
        distance,
        impactAngleDeg: normalAngleDeg,
        effectiveThickness,
        shellPen,
        penetrated: false,
        ricochet: false,
        missed: false,
        armorNeutralized: true,
        postPenDamage: 0,
        crewKilled: false,
        resultText: `命中反应装甲(ERA)，${ammo.name} 金属射流被引爆失效`,
        impactPoint3D: impactPoint,
        normalVector: normal,
        trueIncidentAngleDeg,
        ricochetDirection: null,
      };
    } else {
      shellPen *= 0.7;
    }
  } else if (armor.armorType === 'composite') {
    if (ammo.postPen === 'jet') shellPen *= 0.85;
    else shellPen *= 0.95;
  }

  // 穿透 / 跳弹判定（符合 WT 语义：角度超阈值先跳弹，HE 除外）
  if (ammo.postPen === 'blast') {
    penetrated = true;
  } else if (normalAngleDeg > ammo.ricochetThreshold) {
    ricochet = true;
  } else if (shellPen >= effectiveThickness) {
    penetrated = true;
  }

  // 根据 3D 命中点查找最近的分区，映射到 2D zone key
  const nearestZoneKey = findNearestZone3DKey(impactPoint);

  // 后效伤害（通过策略模式）
  let postPenDamage = 0;
  let crewKilled = false;
  let postEffectDetails: PostEffectDetail | undefined;
  if (ammo.postPen === 'blast' || penetrated) {
    // 从 2D 分区数据中查找匹配分区，获取 adjacentZones 等完整信息
    const matching2DZone = VEHICLE.zones.find(z => z.key === nearestZoneKey);

    const zoneForStrategy: Zone = {
      key: nearestZoneKey ?? '3d',
      label: armor.label,
      category: armor.category,
      armorType: armor.armorType,
      nominalThickness: armor.nominalThickness,
      slope: normalAngleDeg,
      rect: { x: 0, y: 0, w: 0, h: 0 },
      labelPos: { x: 0, y: 0 },
      damageWeight: 0,
      // 从 2D 分区复制 adjacentZones，确保破片锥溅射计算可获取相邻分区
      adjacentZones: matching2DZone?.adjacentZones ?? [],
    };
    const adjacentZoneMap = buildAdjacentZoneMap(VEHICLE.zones);
    const strategy = getPostEffectStrategy(ammo.postPen);
    const effect = strategy.compute({ ammo, zone: zoneForStrategy, penetrated: true, adjacentZoneMap });
    postPenDamage = effect.postPenDamage;
    crewKilled = effect.crewKilled;
    postEffectDetails = effect.postEffectDetails;
  }

  // 反弹方向（弹丸方向减去法线分量，沿表面滑出）
  let ricochetDirection: Vector3 | null = null;
  if (ricochet) {
    const dn = vec3Dot(shotDir, normal);
    ricochetDirection = vec3Normalize(
      vec3Subtract(shotDir, vec3Scale(normal, dn))
    );
  }

  const resultText = buildResultText(
    ammo,
    { key: nearestZoneKey ?? '3d', label: armor.label, category: armor.category, armorType: armor.armorType, nominalThickness: armor.nominalThickness, slope: normalAngleDeg, rect: { x: 0, y: 0, w: 0, h: 0 }, labelPos: { x: 0, y: 0 }, damageWeight: 0 },
    distance, normalAngleDeg, effectiveThickness, shellPen, penetrated, ricochet, armorNeutralized, postPenDamage, crewKilled,
  );

  return {
    distance,
    impactAngleDeg: normalAngleDeg,
    effectiveThickness,
    shellPen,
    penetrated,
    ricochet,
    missed: false,
    armorNeutralized,
    postPenDamage,
    crewKilled,
    resultText,
    postEffectDetails,
    impactPoint3D: impactPoint,
    normalVector: normal,
    trueIncidentAngleDeg,
    ricochetDirection,
  };
}
