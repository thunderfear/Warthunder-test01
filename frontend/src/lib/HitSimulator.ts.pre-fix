// 命中模拟编排：串起弹道 -> 穿透判定 -> 后效，生成一次完整命中结果。
import type { Ammo, AmmoTypeId } from '../data/ammo';
import { getAmmo } from '../data/ammo';
import type { Zone } from '../data/vehicle';
import { VEHICLE } from '../data/vehicle';
import { evaluateHit, evaluateHit3D, type PenetrationResult, type PenetrationResult3D, type Armor3D } from './penetration';
import type { Vector3 } from './ballistics';
import { computeBallistics3D } from './ballistics';

export interface SimHit {
  ammoId: AmmoTypeId;
  zoneKey: string | null;
  distance: number;
  result: PenetrationResult;
  trajectory?: { x: number; y: number; z: number }[];
}

export interface SimHit3D {
  ammoId: AmmoTypeId;
  armorKey: string | null;
  distance: number;
  impactPoint: Vector3;
  shotDirection: Vector3;
  result: PenetrationResult3D;
}

export function simulateHit(ammo: Ammo, zone: Zone | null, distance: number): SimHit {
  const result = evaluateHit({ ammo, zone, distance });

  // 生成弹道轨迹采样点（用于 3D 可视化）
  // 坐标系：弹道坐标系 (x=前方, y=右侧, z=上方)，与 computeBallistics3D 一致
  // BallisticTrail 组件负责将弹道坐标转换为 Three.js 场景坐标 (x=右, y=上, z=前)
  const SAMPLE_COUNT = 20;
  const angleRad = (result.impactAngleDeg * Math.PI) / 180;
  const ballistics = computeBallistics3D({
    muzzleVelocity: ammo.muzzleVelocity,
    caliber: ammo.caliber,
    ballisticCoefficient: ammo.ballisticCoefficient,
    distance,
    angle: result.impactAngleDeg,
  });
  const tof = ballistics.timeOfFlight;
  // 初始垂直速度 = v0 * sin(仰角)，弹道坐标系 z=上
  const vz0 = ammo.muzzleVelocity * Math.sin(angleRad);
  const trajectory: { x: number; y: number; z: number }[] = [];
  for (let i = 0; i <= SAMPLE_COUNT; i++) {
    const t = (i / SAMPLE_COUNT) * tof;
    const fwd = distance * (t / tof);                          // 前方距离（弹道坐标系 x）
    const hgt = vz0 * t - 0.5 * 9.81 * t * t;                // 高度（弹道坐标系 z）
    // 弹道坐标系: x=前方, y=右侧(无侧风=0), z=上方
    trajectory.push({ x: fwd, y: 0, z: hgt });
  }

  return {
    ammoId: ammo.id,
    zoneKey: zone ? zone.key : null,
    distance,
    result,
    trajectory,
  };
}

/**
 * 3D命中模拟：调用 computeBallistics3D 计算弹道，调用 evaluateHit3D 判定命中结果
 */
export function simulateHit3D(opts: {
  ammo: Ammo;
  armor: Armor3D | null;
  impactPoint: Vector3;
  shotDirection: Vector3;
  distance: number;
}): SimHit3D {
  const { ammo, armor, impactPoint, shotDirection, distance } = opts;

  const result = evaluateHit3D({
    ammo,
    armor,
    impactPoint,
    shotDirection,
    distance,
  });

  return {
    ammoId: ammo.id,
    armorKey: armor ? '3d_armor' : null,
    distance,
    impactPoint,
    shotDirection,
    result,
  };
}

// ─── 直线轨迹生成器（3D 场景用）───

/**
 * 生成 2 点直线轨迹：生成点 → 目标点
 * 生成点 = targetPos 沿 z 轴负方向偏移 spawnDistance，或使用自定义 origin
 */
export function generateStraightTrajectory(
  targetPos: { x: number; y: number; z: number },
  spawnDistance: number = 6,
  origin?: { x: number; y: number; z: number },
): Vector3[] {
  const spawnPoint: Vector3 = origin
    ? { x: origin.x, y: origin.y, z: origin.z }
    : {
        x: targetPos.x,
        y: targetPos.y,
        z: targetPos.z - spawnDistance,
      };
  return [spawnPoint, { x: targetPos.x, y: targetPos.y, z: targetPos.z }];
}

/**
 * 合成场景内直线视觉轨迹（自动开火 fireRandom 用）：视觉与物理解耦。
 *
 * 目标点 = 被命中分区 collision.position，生成点 = 沿"原点→目标点"方向放大至
 * spawnRadius 距离的场景边缘合成射手点（默认 13 单位，位于 30×30 地面网格边缘内、
 * fog near=18 之前，炮弹可见地从远处飞入、落点在装甲上）。
 *
 * 背景：fireRandom 的物理轨迹为米制抛物线（弹道坐标 x∈[150,1500]），而 3D 场景
 * 仅约 30 单位大（camera far=100、fog 18-45），直接渲染会被视锥裁剪+雾遮蔽导致
 * "炮弹消失、落点不在装甲上"。物理判定（穿深/跳弹由 distance 驱动的 evaluateHit）
 * 不变，本函数仅提供场景内可见的入射直线。
 *
 * 坐标语义：输入输出均为 Three.js 场景坐标（x=右, y=上, z=前），与
 * simulateHit3DStraight 的 trajectory 一致（经 BattleScene3D 预置换后由 BallisticTrail 还原）。
 */
export function synthSceneTrajectory(
  targetPos: { x: number; y: number; z: number },
  spawnRadius: number = 13,
): Vector3[] {
  const len = Math.sqrt(
    targetPos.x * targetPos.x + targetPos.y * targetPos.y + targetPos.z * targetPos.z,
  );
  // 目标点在原点（分区均有偏置，理论不触发）：退化为 +Z 方向生成点，保证轨迹仍有效
  const spawn: Vector3 = len > 1e-6
    ? {
        x: (targetPos.x / len) * spawnRadius,
        y: (targetPos.y / len) * spawnRadius,
        z: (targetPos.z / len) * spawnRadius,
      }
    : { x: 0, y: 0, z: spawnRadius };
  return generateStraightTrajectory(targetPos, 0, spawn);
}

/**
 * 3D直线命中模拟：生成直线轨迹 + 调用穿透判定，返回与 SimHit 兼容的结果
 * result 为 PenetrationResult3D（impactPoint3D/ricochetDirection 为 Three 场景坐标，coordSpace='three'）
 * @param zoneNormal 可选的装甲表面法向量（优先来自点击面法线，其次 vehicle3d 的 surfaceNormal）
 *                   如果提供，用作装甲法线；否则使用射击方向的反方向（垂直命中）
 * @param shotOrigin 可选的射击起点（如摄像头位置），用于计算真实射击方向
 *                   如果提供，shotDirection = 从 shotOrigin 指向 target 的方向
 * @param zone3d 可选的被点击分区装甲数据（armor=标称厚度mm，armorType=装甲类型）
 *               如果提供，替代默认 100mm RHA 硬编码
 */
export function simulateHit3DStraight(
  ammoId: AmmoTypeId,
  distance: number,
  targetZone3DPos: { x: number; y: number; z: number },
  zoneNormal?: Vector3,
  shotOrigin?: Vector3,
  zone3d?: { armor: number; armorType: string },
): SimHit & { trajectory: Vector3[]; result: PenetrationResult3D } {
  const ammo = getAmmo(ammoId);
  const trajectory = generateStraightTrajectory(targetZone3DPos, 6, shotOrigin);

  // 射击方向 = 从射击起点指向目标点（归一化）
  const dx = targetZone3DPos.x - trajectory[0].x;
  const dy = targetZone3DPos.y - trajectory[0].y;
  const dz = targetZone3DPos.z - trajectory[0].z;
  const len = Math.sqrt(dx * dx + dy * dy + dz * dz);
  const shotDirection: Vector3 = len > 0
    ? { x: dx / len, y: dy / len, z: dz / len }
    : { x: 0, y: 0, z: 1 };

  // 装甲法线：优先使用分区定义的表面法向量，否则回退到射击方向反方向（垂直命中）
  const normalVector: Vector3 = zoneNormal
    ? { x: zoneNormal.x, y: zoneNormal.y, z: zoneNormal.z }
    : { x: -shotDirection.x, y: -shotDirection.y, z: -shotDirection.z };

  // 构造装甲信息：优先使用被点击分区的真实装甲数据，无则回退默认 100mm RHA
  // 注：传入的 armorType 为 string（Zone3DDef 定义），需收窄为 Armor3D 支持的字面量联合类型
  const VALID_ARMOR_TYPES: readonly string[] = ['RHA', 'spaced', 'composite', 'ERA'];
  const armorType: Armor3D['armorType'] =
    zone3d && VALID_ARMOR_TYPES.includes(zone3d.armorType)
      ? (zone3d.armorType as Armor3D['armorType'])
      : 'RHA';
  const armor: Armor3D = {
    nominalThickness: zone3d?.armor ?? 100,
    normalVector,
    armorType,
    category: 'armor',
    label: '装甲',
  };

  const result = evaluateHit3D({
    ammo,
    armor,
    impactPoint: { x: targetZone3DPos.x, y: targetZone3DPos.y, z: targetZone3DPos.z },
    shotDirection,
    distance,
  });

  return {
    ammoId,
    zoneKey: null,
    distance,
    result: {
      ...result,
      // 保持 PenetrationResult 兼容字段
      impactAngleDeg: result.impactAngleDeg,
      effectiveThickness: result.effectiveThickness,
      shellPen: result.shellPen,
      penetrated: result.penetrated,
      ricochet: result.ricochet,
      missed: result.missed,
      armorNeutralized: result.armorNeutralized,
      postPenDamage: result.postPenDamage,
      crewKilled: result.crewKilled,
      resultText: result.resultText,
      postEffectDetails: result.postEffectDetails,
      // 坐标系打标：本函数的 impactPoint3D/ricochetDirection 均为 Three.js 场景坐标（x=右, y=上, z=前），
      // 渲染端（HitEffects）据此跳过弹道→场景置换
      coordSpace: 'three' as const,
    },
    trajectory,
  };
}

// 随机一发（用于"自动开火"演示）：随机选分区 + 随机距离
export function randomHit(ammoId: AmmoTypeId): SimHit {
  const ammo = getAmmo(ammoId);
  const zones = VEHICLE.zones;
  const zone = zones[Math.floor(Math.random() * zones.length)];
  const distance = 150 + Math.floor(Math.random() * 1350); // 150–1500m
  return simulateHit(ammo, zone, distance);
}
