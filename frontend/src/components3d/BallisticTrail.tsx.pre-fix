/**
 * BallisticTrail.tsx - 3D弹道轨迹线组件
 * 使用 drei 的 <Line> 渲染弹道轨迹，无粒子系统
 * 支持虚线效果和弹药颜色
 *
 * 坐标系说明：
 *   HitSimulator 生成的轨迹点使用弹道坐标系 (x=前方, y=右侧, z=上方)
 *   Three.js 场景使用右手坐标系 (x=右, y=上, z=前)
 *   vec3ToTuple 负责将弹道坐标转换为 Three.js 场景坐标
 */
import { useMemo, useRef } from 'react';
import { useFrame } from '@react-three/fiber';
import { Line } from '@react-three/drei';
import * as THREE from 'three';
import type { Vector3 } from '../lib/ballistics';

// 共享炮弹几何体（避免每帧创建）
const SHARED_PROJECTILE_GEOMETRY = new THREE.CapsuleGeometry(0.08, 0.4, 4, 8);
SHARED_PROJECTILE_GEOMETRY.rotateX(Math.PI / 2); // 胶囊长轴 Y→Z，与 lookAt 的 +Z 前方语义对齐

// ─── Props ───
export interface BallisticTrailProps {
  points: Vector3[];              // 弹道轨迹点数组
  color?: string;                 // 轨迹的颜色（默认使用弹药 tracerColor）
  lineWidth?: number;             // 线宽（像素）
  dashed?: boolean;               // 是否虚线
  dashSize?: number;              // 虚线段长
  gapSize?: number;               // 虚线间隔
  visible?: boolean;
  opacity?: number;
  offset?: [number, number, number]; // 轨迹偏移（右侧, 上方, 前方）
  showProjectile?: boolean;       // 是否显示炮弹模型动画
  projectileDuration?: number;    // 炮弹飞行持续时间（秒），默认 0.5
  onProjectileImpact?: () => void; // 炮弹到达终点时的回调
  breakOnImpact?: boolean;         // 是否在碰撞时破裂（默认 false）
  speedMultiplier?: number;        // 动画速度倍率（默认 1）
}

/**
 * 将弹道坐标(Vector3)转换为 Three.js 场景坐标
 *
 * 弹道坐标系: x=前方, y=右侧, z=上方
 * Three.js:    x=右,   y=上,   z=前方
 *
 * 转换规则: threeX = ballisticY, threeY = ballisticZ, threeZ = ballisticX
 * 同时叠加 offset 偏移（offset 已是 Three.js 坐标系: [右, 上, 前]）
 */
function vec3ToTuple(v: Vector3, offset: [number, number, number]): [number, number, number] {
  return [v.y + offset[0], v.z + offset[1], v.x + offset[2]];
}

export default function BallisticTrail({
  points,
  color = '#ffaa00',
  lineWidth = 2,
  dashed = true,
  dashSize = 0.3,
  gapSize = 0.15,
  visible = true,
  opacity = 0.7,
  offset = [0, 2.0, 0],
  showProjectile = true,
  projectileDuration = 0.5,
  onProjectileImpact,
  breakOnImpact = false,
  speedMultiplier = 1,
}: BallisticTrailProps) {
  // 将 Vector3[] 转换为 Line 组件需要的格式（含坐标转换和偏移）
  const linePoints = useMemo(() => {
    return points.map((p) => vec3ToTuple(p, offset));
  }, [points, offset]);

  // 炮弹动画状态
  const projectileRef = useRef<THREE.Mesh>(null);
  const projectileGroupRef = useRef<THREE.Group>(null);
  const progressRef = useRef(0);

  // 炮弹飞行动画
  const impactFired = useRef(false);
  useFrame((state, delta) => {
    if (!showProjectile || !projectileRef.current || !projectileGroupRef.current || linePoints.length < 2) return;

    const clampedDelta = Math.min(delta, 0.1);
    progressRef.current += clampedDelta / projectileDuration * speedMultiplier;

    if (progressRef.current >= 1) {
      progressRef.current = 1;
      // 碰撞破裂逻辑
      if (breakOnImpact && !impactFired.current) {
        impactFired.current = true;
        if (projectileGroupRef.current) projectileGroupRef.current.visible = false;
        onProjectileImpact?.();
      }
      return;
    }

    // 沿轨迹插值计算炮弹位置
    const totalSegments = linePoints.length - 1;
    const segmentProgress = progressRef.current * totalSegments;
    const segmentIndex = Math.min(Math.floor(segmentProgress), totalSegments - 1);
    const segmentT = segmentProgress - segmentIndex;

    const start = linePoints[segmentIndex];
    const end = linePoints[segmentIndex + 1];

    // 线性插值位置
    const x = start[0] + (end[0] - start[0]) * segmentT;
    const y = start[1] + (end[1] - start[1]) * segmentT;
    const z = start[2] + (end[2] - start[2]) * segmentT;

    projectileGroupRef.current.position.set(x, y, z);

    // 炮弹朝向飞行方向（直线轨迹也执行；距离过近时跳过防 eye==target 退化）
    const dx = end[0] - x, dy = end[1] - y, dz = end[2] - z;
    if (dx * dx + dy * dy + dz * dz > 1e-8) {
      projectileRef.current.lookAt(end[0], end[1], end[2]);
    }
  });

  if (!visible || linePoints.length < 2) return null;

  return (
    <group>
      {/* 黄色虚线（原有样式保留） */}
      <Line
        points={linePoints}
        color={color}
        lineWidth={lineWidth}
        dashed={dashed}
        dashSize={dashSize}
        gapSize={gapSize}
        transparent
        opacity={opacity}
      />



      {/* 炮弹模型（可选，使用弹药曳光色） */}
      {showProjectile && (
        <group ref={projectileGroupRef}>
          {/* 炮弹主体 */}
          <mesh ref={projectileRef} castShadow>
            <primitive object={SHARED_PROJECTILE_GEOMETRY} attach="geometry" />
            <meshStandardMaterial
              color={color}
              metalness={0.7}
              roughness={0.3}
              emissive={color}
              emissiveIntensity={0.5}
            />
          </mesh>
          {/* 炮弹辉光效果（跟随炮弹移动） */}
          <pointLight
            color={color}
            intensity={0.8}
            distance={2}
          />
        </group>
      )}
    </group>
  );
}
