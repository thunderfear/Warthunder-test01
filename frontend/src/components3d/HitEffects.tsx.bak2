/**
 * HitEffects.tsx - 命中效果组件（纯几何体+HTML标注，无粒子）
 * 4种基础效果：击穿、跳弹、未击穿、ERA化解
 * 5种特殊事件效果：发动机起火、油箱起火、弹药烘烤、弹药殉爆、火炮卡弹
 * 所有效果用 useFrame 做简单动画
 */
import { useRef, useState, useMemo, useEffect } from 'react';
import { useFrame } from '@react-three/fiber';
import { Html, Line } from '@react-three/drei';
import * as THREE from 'three';
import type { PenetrationResult3D } from '../lib/penetration';
import type { Vector3 } from '../lib/ballistics';
import type { SpecialEvent } from '../lib/chainReactions';
import { getZone3D } from '../data/vehicle3d';
import { useBattleStore } from '../store/battleStore';

// ─── 效果类型 ───
type HitEffectType = 'penetration' | 'ricochet' | 'non_penetration' | 'era_neutralized';

function getEffectType(result: PenetrationResult3D): HitEffectType {
  if (result.armorNeutralized) return 'era_neutralized';
  if (result.ricochet) return 'ricochet';
  if (result.penetrated) return 'penetration';
  return 'non_penetration';
}

// ─── Props ───
export interface HitEffectItem {
  id: string;
  result: PenetrationResult3D;
  position: Vector3;
}

export interface HitEffectsProps {
  effects: HitEffectItem[];
  onEffectComplete?: (id: string) => void;
}

// ─── 单个效果组件 ───
function SingleHitEffect({ effect, onComplete }: { effect: HitEffectItem; onComplete: (id: string) => void }) {
  const type = getEffectType(effect.result);
  // ballistic (x=前, y=右, z=上) → three.js (x=右, y=上, z=前)
  const pos: [number, number, number] = [effect.position.y, effect.position.z, effect.position.x];

  switch (type) {
    case 'penetration':
      return <PenetrationEffect position={pos} damage={effect.result.postPenDamage} onComplete={() => onComplete(effect.id)} />;
    case 'ricochet':
      return <RicochetEffect position={pos} ricochetDir={effect.result.ricochetDirection} onComplete={() => onComplete(effect.id)} />;
    case 'non_penetration':
      return <NonPenetrationEffect position={pos} onComplete={() => onComplete(effect.id)} />;
    case 'era_neutralized':
      return <ERAEffect position={pos} onComplete={() => onComplete(effect.id)} />;
  }
}

// ─── 击穿效果：随机小方块 + 红色伤害数值 ───
function PenetrationEffect({ position, damage, onComplete }: { position: [number, number, number]; damage: number; onComplete: () => void }) {
  const groupRef = useRef<THREE.Group>(null);
  const elapsedRef = useRef(0);
  const completed = useRef(false);
  const duration = 1.5; // 1.5秒
  const replaySpeed = useBattleStore(s => s.replaySpeed);

  // 随机碎片位置
  const debris = useMemo(() => {
    const pieces: { pos: [number, number, number]; scale: [number, number, number]; vel: [number, number, number] }[] = [];
    for (let i = 0; i < 6; i++) {
      pieces.push({
        pos: [(Math.random() - 0.5) * 0.2, (Math.random() - 0.5) * 0.2, (Math.random() - 0.5) * 0.2],
        scale: [0.05 + Math.random() * 0.05, 0.05 + Math.random() * 0.05, 0.05 + Math.random() * 0.05],
        vel: [(Math.random() - 0.5) * 2, Math.random() * 2, (Math.random() - 0.5) * 2],
      });
    }
    return pieces;
  }, []);

  useFrame((_, delta) => {
    if (!groupRef.current || completed.current) return;
    const clampedDelta = Math.min(delta, 0.1);
    elapsedRef.current += clampedDelta * replaySpeed;
    const t = Math.min(1, elapsedRef.current / duration);

    if (t >= 1) {
      completed.current = true;
      onComplete();
      return;
    }

    // 碎片飞散动画
    groupRef.current.children.forEach((child, i) => {
      if (i < debris.length && child instanceof THREE.Mesh) {
        const d = debris[i];
        child.position.x = d.pos[0] + d.vel[0] * t * 0.3;
        child.position.y = d.pos[1] + d.vel[1] * t * 0.3 - 0.5 * t * t;
        child.position.z = d.pos[2] + d.vel[2] * t * 0.3;
        child.scale.setScalar(1 - t);
      }
    });
  });

  return (
    <group ref={groupRef} position={position}>
      {debris.map((d, i) => (
        <mesh key={i} position={d.pos} scale={d.scale}>
          <boxGeometry args={[1, 1, 1]} />
          <meshStandardMaterial color="#ff3300" emissive="#ff2200" emissiveIntensity={0.5} />
        </mesh>
      ))}
      <Html center distanceFactor={10} style={{ pointerEvents: 'none' }}>
        <div style={{
          color: '#ff3300',
          fontSize: '14px',
          fontWeight: 'bold',
          textShadow: '0 0 4px #ff0000',
          whiteSpace: 'nowrap',
          transform: 'translateY(-20px)',
        }}>
          -{damage}%
        </div>
      </Html>
    </group>
  );
}

// ─── 跳弹效果：反弹方向线段 + 箭头圆锥 + 黄色"跳弹"文字 ───
function RicochetEffect({ position, ricochetDir, onComplete }: { position: [number, number, number]; ricochetDir: Vector3 | null; onComplete: () => void }) {
  const groupRef = useRef<THREE.Group>(null);
  const coneRef = useRef<THREE.Mesh>(null);
  const elapsedRef = useRef(0);
  const completed = useRef(false);
  const duration = 1.8;
  const replaySpeed = useBattleStore(s => s.replaySpeed);

  // 反弹方向在 Three.js 坐标系中的表示
  // ballistic (x=前, y=右, z=上) → three.js (x=右, y=上, z=前)
  const threeDir = useMemo((): THREE.Vector3 => {
    if (!ricochetDir) return new THREE.Vector3(1, 0.5, 0).normalize();
    return new THREE.Vector3(ricochetDir.y, ricochetDir.z, ricochetDir.x).normalize();
  }, [ricochetDir]);

  // 反弹线段终点（Three.js坐标系）
  const lineEnd = useMemo((): [number, number, number] => {
    return [threeDir.x * 1.5, threeDir.y * 1.5, threeDir.z * 1.5];
  }, [threeDir]);

  // 圆锥体旋转：让Y轴对齐到反弹方向
  const coneQuaternion = useMemo(() => {
    const q = new THREE.Quaternion();
    q.setFromUnitVectors(new THREE.Vector3(0, 1, 0), threeDir);
    return q;
  }, [threeDir]);

  useEffect(() => {
    if (coneRef.current) {
      coneRef.current.quaternion.copy(coneQuaternion);
    }
  }, [coneQuaternion]);

  useFrame((_, delta) => {
    if (!groupRef.current || completed.current) return;
    const clampedDelta = Math.min(delta, 0.1);
    elapsedRef.current += clampedDelta * replaySpeed;
    const t = Math.min(1, elapsedRef.current / duration);
    if (t >= 1) {
      completed.current = true;
      onComplete();
      return;
    }
    // 整体淡出
    groupRef.current.scale.setScalar(1 - t * 0.5);
  });

  return (
    <group ref={groupRef} position={position}>
      {/* 反弹方向线段 */}
      <Line
        points={[[0, 0, 0], lineEnd]}
        color="#ffcc00"
        lineWidth={3}
        dashed
        dashSize={0.15}
        gapSize={0.1}
      />
      {/* 反弹方向箭头圆锥 */}
      <mesh ref={coneRef} position={lineEnd}>
        <coneGeometry args={[0.08, 0.2, 8]} />
        <meshStandardMaterial
          color="#ffcc00"
          emissive="#ffaa00"
          emissiveIntensity={0.6}
          metalness={0.7}
          roughness={0.3}
        />
      </mesh>
      {/* 命中点火花标记 */}
      <mesh>
        <sphereGeometry args={[0.05, 8, 6]} />
        <meshStandardMaterial color="#ffffff" emissive="#ffcc00" emissiveIntensity={0.8} />
      </mesh>
      <Html center distanceFactor={10} style={{ pointerEvents: 'none' }}>
        <div style={{
          color: '#ffcc00',
          fontSize: '13px',
          fontWeight: 'bold',
          textShadow: '0 0 4px #ffaa00',
          whiteSpace: 'nowrap',
          transform: 'translateY(-18px)',
        }}>
          跳弹
        </div>
      </Html>
    </group>
  );
}

// ─── 未击穿效果：扁平小圆柱（压扁弹头）+ 灰色"未击穿"文字 ───
function NonPenetrationEffect({ position, onComplete }: { position: [number, number, number]; onComplete: () => void }) {
  const meshRef = useRef<THREE.Mesh>(null);
  const elapsedRef = useRef(0);
  const completed = useRef(false);
  const duration = 1.6;
  const replaySpeed = useBattleStore(s => s.replaySpeed);

  useFrame((_, delta) => {
    if (!meshRef.current || completed.current) return;
    const clampedDelta = Math.min(delta, 0.1);
    elapsedRef.current += clampedDelta * replaySpeed;
    const t = Math.min(1, elapsedRef.current / duration);
    if (t >= 1) {
      completed.current = true;
      onComplete();
      return;
    }
    // 压扁动画：Y轴缩小，XZ轴扩大
    const squash = 1 - t * 0.3;
    meshRef.current.scale.set(1 + t * 0.3, squash * 0.3, 1 + t * 0.3);
  });

  return (
    <group position={position}>
      <mesh ref={meshRef}>
        <cylinderGeometry args={[0.08, 0.12, 0.15, 12]} />
        <meshStandardMaterial color="#666666" roughness={0.9} metalness={0.5} />
      </mesh>
      <Html center distanceFactor={10} style={{ pointerEvents: 'none' }}>
        <div style={{
          color: '#999999',
          fontSize: '12px',
          fontWeight: 'bold',
          whiteSpace: 'nowrap',
          transform: 'translateY(-16px)',
        }}>
          未击穿
        </div>
      </Html>
    </group>
  );
}

// ─── ERA化解效果：小方块从有到无的缩放动画 + 橙色"ERA"文字 ───
function ERAEffect({ position, onComplete }: { position: [number, number, number]; onComplete: () => void }) {
  const groupRef = useRef<THREE.Group>(null);
  const elapsedRef = useRef(0);
  const completed = useRef(false);
  const duration = 1.4;
  const replaySpeed = useBattleStore(s => s.replaySpeed);

  // ERA方块
  const blocks = useMemo(() => {
    const b: { pos: [number, number, number]; delay: number }[] = [];
    for (let i = 0; i < 4; i++) {
      b.push({
        pos: [(Math.random() - 0.5) * 0.3, (Math.random() - 0.5) * 0.3, (Math.random() - 0.5) * 0.3],
        delay: i * 0.15,
      });
    }
    return b;
  }, []);

  useFrame((_, delta) => {
    if (!groupRef.current || completed.current) return;
    const clampedDelta = Math.min(delta, 0.1);
    elapsedRef.current += clampedDelta * replaySpeed;
    const t = Math.min(1, elapsedRef.current / duration);
    if (t >= 1) {
      completed.current = true;
      onComplete();
      return;
    }

    groupRef.current.children.forEach((child, i) => {
      if (i < blocks.length && child instanceof THREE.Mesh) {
        const block = blocks[i];
        const localT = Math.max(0, Math.min(1, (t - block.delay) / (1 - block.delay)));
        // 先放大后消失
        const scale = localT < 0.5 ? 1 + localT : Math.max(0, 2 - localT * 3);
        child.scale.setScalar(scale);
      }
    });
  });

  return (
    <group ref={groupRef} position={position}>
      {blocks.map((b, i) => (
        <mesh key={i} position={b.pos}>
          <boxGeometry args={[0.1, 0.1, 0.1]} />
          <meshStandardMaterial color="#ff8800" emissive="#ff6600" emissiveIntensity={0.4} />
        </mesh>
      ))}
      <Html center distanceFactor={10} style={{ pointerEvents: 'none' }}>
        <div style={{
          color: '#ff8800',
          fontSize: '14px',
          fontWeight: 'bold',
          textShadow: '0 0 4px #ff6600',
          whiteSpace: 'nowrap',
          transform: 'translateY(-18px)',
        }}>
          ERA
        </div>
      </Html>
    </group>
  );
}

// ─── 辅助：获取分区3D中心位置 ───
function getZoneCenter(zoneKey: string): [number, number, number] {
  const zone = getZone3D(zoneKey);
  if (!zone) return [0, 0, 0];
  const col = zone.collision;
  return [col.position[0], col.position[1], col.position[2]];
}

// ═══════════════════════════════════════════
// 5种特殊事件视觉效果组件
// ═══════════════════════════════════════════

// ─── 1. 发动机起火效果 ───
function EngineFireEffect({ position, onComplete }: { position: [number, number, number]; onComplete: () => void }) {
  const groupRef = useRef<THREE.Group>(null);
  const elapsedRef = useRef(0);
  const completed = useRef(false);
  const duration = 3.0;
  const replaySpeed = useBattleStore(s => s.replaySpeed);

  useFrame((_, delta) => {
    if (!groupRef.current || completed.current) return;
    const clampedDelta = Math.min(delta, 0.1);
    elapsedRef.current += clampedDelta * replaySpeed;
    const t = Math.min(1, elapsedRef.current / duration);
    if (t >= 1) { completed.current = true; onComplete(); return; }

    // 烟雾缓慢上升 + 扩大
    groupRef.current.position.y = position[1] + t * 0.8;
    groupRef.current.scale.setScalar(1 + t * 1.5);
    // 淡出
    groupRef.current.children.forEach(child => {
      if (child instanceof THREE.Mesh && child.material instanceof THREE.MeshStandardMaterial) {
        child.material.opacity = 1 - t;
      }
    });
  });

  return (
    <group ref={groupRef} position={position}>
      <mesh>
        <sphereGeometry args={[0.3, 10, 8]} />
        <meshStandardMaterial color="#888888" transparent opacity={0.5} emissive="#444444" emissiveIntensity={0.3} />
      </mesh>
      <Html center distanceFactor={10} style={{ pointerEvents: 'none' }}>
        <div style={{ color: '#ff8800', fontSize: '13px', fontWeight: 'bold', textShadow: '0 0 6px #ff6600', whiteSpace: 'nowrap', transform: 'translateY(-24px)' }}>
          发动机起火
        </div>
      </Html>
    </group>
  );
}

// ─── 2. 油箱起火效果 ───
function FuelFireEffect({ position, onComplete }: { position: [number, number, number]; onComplete: () => void }) {
  const meshRef = useRef<THREE.Mesh>(null);
  const matRef = useRef<THREE.MeshStandardMaterial>(null);
  const elapsedRef = useRef(0);
  const completed = useRef(false);
  const duration = 3.0;
  const replaySpeed = useBattleStore(s => s.replaySpeed);

  useFrame((_, delta) => {
    if (!meshRef.current || completed.current) return;
    const clampedDelta = Math.min(delta, 0.1);
    elapsedRef.current += clampedDelta * replaySpeed;
    const elapsed = elapsedRef.current * 1000; // 用于闪烁频率计算（保持原始频率）
    const t = Math.min(1, elapsedRef.current / duration);
    if (t >= 1) { completed.current = true; onComplete(); return; }

    // 缩放闪烁 0.8-1.2
    const scale = 1 + 0.2 * Math.sin(elapsed * 0.008);
    meshRef.current.scale.setScalar(scale);
    // 颜色交替 #ff6600 <-> #ff9900
    if (matRef.current) {
      const mix = (Math.sin(elapsed * 0.006) + 1) / 2;
      matRef.current.color.setRGB(1, 0.4 + mix * 0.2, mix * 0.2);
      matRef.current.emissive.setRGB(1, 0.4 + mix * 0.2, 0);
    }
  });

  return (
    <group position={position}>
      <mesh ref={meshRef}>
        <sphereGeometry args={[0.25, 10, 8]} />
        <meshStandardMaterial ref={matRef} color="#ff6600" emissive="#ff4400" emissiveIntensity={0.8} transparent opacity={0.85} />
      </mesh>
      <Html center distanceFactor={10} style={{ pointerEvents: 'none' }}>
        <div style={{ color: '#ff3300', fontSize: '13px', fontWeight: 'bold', textShadow: '0 0 6px #ff0000', whiteSpace: 'nowrap', transform: 'translateY(-24px)' }}>
          油箱起火
        </div>
      </Html>
    </group>
  );
}

// ─── 3. 弹药烘烤效果（殉爆前兆）───
function AmmoCookoffEffect({ position, delaySeconds, onComplete }: { position: [number, number, number]; delaySeconds: number; onComplete: () => void }) {
  const meshRef = useRef<THREE.Mesh>(null);
  const elapsedRef = useRef(0);
  const completed = useRef(false);
  const duration = Math.min(delaySeconds, 8.0);
  const countdownRef = useRef(delaySeconds);
  const [countdown, setCountdown] = useState(delaySeconds);
  const replaySpeed = useBattleStore(s => s.replaySpeed);

  useFrame((_, delta) => {
    if (!meshRef.current || completed.current) return;
    const clampedDelta = Math.min(delta, 0.1);
    elapsedRef.current += clampedDelta * replaySpeed;
    const elapsed = elapsedRef.current * 1000; // 用于闪烁频率计算（保持原始频率）
    const t = Math.min(1, elapsedRef.current / duration);
    if (t >= 1) { completed.current = true; onComplete(); return; }

    // 快速闪烁（可见/不可见交替）
    const blink = Math.sin(elapsed * 0.015) > 0;
    meshRef.current.visible = blink;
    // 随倒计时加速闪烁
    const remaining = Math.max(0, delaySeconds - elapsedRef.current);
    meshRef.current.scale.setScalar(0.8 + 0.4 * (1 - remaining / delaySeconds));
    // 更新倒计时显示（每秒更新一次）
    const newCd = Math.ceil(remaining);
    if (newCd !== countdownRef.current) {
      countdownRef.current = newCd;
      setCountdown(newCd);
    }
  });

  return (
    <group position={position}>
      <mesh ref={meshRef}>
        <sphereGeometry args={[0.2, 8, 6]} />
        <meshStandardMaterial color="#ff0000" emissive="#ff2200" emissiveIntensity={1.0} />
      </mesh>
      <Html center distanceFactor={10} style={{ pointerEvents: 'none' }}>
        <div style={{ color: '#ff4444', fontSize: '14px', fontWeight: 'bold', textShadow: '0 0 8px #ff0000', whiteSpace: 'nowrap', transform: 'translateY(-24px)' }}>
          弹药烘烤! {countdown > 0 ? `${countdown}s` : ''}
        </div>
      </Html>
    </group>
  );
}

// ─── 4. 弹药殉爆效果 ───
function AmmoDetonationEffect({ position, onComplete }: { position: [number, number, number]; onComplete: () => void }) {
  const flashRef = useRef<THREE.Mesh>(null);
  const ringRef = useRef<THREE.Mesh>(null);
  const elapsedRef = useRef(0);
  const completed = useRef(false);
  const duration = 2.0;
  const replaySpeed = useBattleStore(s => s.replaySpeed);

  useFrame((_, delta) => {
    if (!flashRef.current || completed.current) return;
    const clampedDelta = Math.min(delta, 0.1);
    elapsedRef.current += clampedDelta * replaySpeed;
    const t = Math.min(1, elapsedRef.current / duration);
    if (t >= 1) { completed.current = true; onComplete(); return; }

    // 白色闪光：快速扩大后淡出
    const flashT = Math.min(1, t * 3); // 前1/3时间扩大
    const flashScale = flashT < 1 ? 1 + flashT * 3 : 4 * (1 - (t - 1/3) / (2/3));
    flashRef.current.scale.setScalar(Math.max(0.1, flashScale));
    if (flashRef.current.material instanceof THREE.MeshStandardMaterial) {
      flashRef.current.material.opacity = Math.max(0, 1 - t * 1.2);
    }

    // 扩散圆环
    if (ringRef.current) {
      const ringT = Math.min(1, t * 2);
      ringRef.current.scale.set(1 + ringT * 4, 1 + ringT * 4, 1);
      if (ringRef.current.material instanceof THREE.MeshStandardMaterial) {
        ringRef.current.material.opacity = Math.max(0, 1 - t * 1.5);
      }
    }
  });

  return (
    <group position={position}>
      {/* 白色闪光球 */}
      <mesh ref={flashRef}>
        <sphereGeometry args={[0.3, 10, 8]} />
        <meshStandardMaterial color="#ffffff" emissive="#ffffff" emissiveIntensity={2} transparent opacity={1} />
      </mesh>
      {/* 扩散圆环 */}
      <mesh ref={ringRef} rotation={[Math.PI / 2, 0, 0]}>
        <ringGeometry args={[0.2, 0.35, 16]} />
        <meshStandardMaterial color="#ffaa00" emissive="#ff6600" emissiveIntensity={1} transparent opacity={0.8} side={THREE.DoubleSide} />
      </mesh>
      <Html center distanceFactor={10} style={{ pointerEvents: 'none' }}>
        <div style={{ color: '#ff0000', fontSize: '18px', fontWeight: 'bold', textShadow: '0 0 10px #ff0000', whiteSpace: 'nowrap', transform: 'translateY(-30px)' }}>
          殉爆！
        </div>
      </Html>
    </group>
  );
}

// ─── 5. 火炮卡弹效果 ───
function GunJamEffect({ position, onComplete }: { position: [number, number, number]; onComplete: () => void }) {
  const groupRef = useRef<THREE.Group>(null);
  const elapsedRef = useRef(0);
  const completed = useRef(false);
  const duration = 2.5;
  const replaySpeed = useBattleStore(s => s.replaySpeed);

  useFrame((_, delta) => {
    if (!groupRef.current || completed.current) return;
    const clampedDelta = Math.min(delta, 0.1);
    elapsedRef.current += clampedDelta * replaySpeed;
    const t = Math.min(1, elapsedRef.current / duration);
    if (t >= 1) { completed.current = true; onComplete(); return; }
    // 整体淡出
    groupRef.current.scale.setScalar(1 - t * 0.3);
  });

  // 红色 X 标记的两条线端点
  const size = 0.25;

  return (
    <group ref={groupRef} position={position}>
      <Line points={[[-size, -size, 0], [size, size, 0]]} color="#ff0000" lineWidth={3} />
      <Line points={[[size, -size, 0], [-size, size, 0]]} color="#ff0000" lineWidth={3} />
      <Html center distanceFactor={10} style={{ pointerEvents: 'none' }}>
        <div style={{ color: '#ff3333', fontSize: '13px', fontWeight: 'bold', textShadow: '0 0 4px #ff0000', whiteSpace: 'nowrap', transform: 'translateY(-22px)' }}>
          火炮卡弹
        </div>
      </Html>
    </group>
  );
}

// ─── 特殊事件效果分发组件 ───
export interface SpecialEventEffectItem {
  id: string;
  event: SpecialEvent;
}

export interface SpecialEventEffectsProps {
  events: SpecialEventEffectItem[];
  onEffectComplete?: (id: string) => void;
}

function SingleSpecialEffect({ item, onComplete }: { item: SpecialEventEffectItem; onComplete: (id: string) => void }) {
  const pos = getZoneCenter(item.event.zoneKey);

  switch (item.event.type) {
    case 'engine_fire':
      return <EngineFireEffect position={pos} onComplete={() => onComplete(item.id)} />;
    case 'fuel_fire':
      return <FuelFireEffect position={pos} onComplete={() => onComplete(item.id)} />;
    case 'ammo_cookoff':
      return <AmmoCookoffEffect position={pos} delaySeconds={item.event.delaySeconds} onComplete={() => onComplete(item.id)} />;
    case 'ammo_detonation':
      return <AmmoDetonationEffect position={pos} onComplete={() => onComplete(item.id)} />;
    case 'gun_jam':
      return <GunJamEffect position={pos} onComplete={() => onComplete(item.id)} />;
    case 'engine_stall':
      // engine_stall 无独立视觉效果，复用发动机起火位置显示简短标注
      return <EngineFireEffect position={pos} onComplete={() => onComplete(item.id)} />;
    default:
      return null;
  }
}

export function SpecialEventEffects({ events, onEffectComplete }: SpecialEventEffectsProps) {
  const [active, setActive] = useState<SpecialEventEffectItem[]>(events);

  useEffect(() => {
    setActive(events);
  }, [events]);

  const handleComplete = (id: string) => {
    setActive(prev => prev.filter(e => e.id !== id));
    onEffectComplete?.(id);
  };

  return (
    <group>
      {active.map(item => (
        <SingleSpecialEffect key={item.id} item={item} onComplete={handleComplete} />
      ))}
    </group>
  );
}

// ─── 主组件 ───
export default function HitEffects({ effects, onEffectComplete }: HitEffectsProps) {
  const [activeEffects, setActiveEffects] = useState<HitEffectItem[]>(effects);

  useEffect(() => {
    setActiveEffects(effects);
  }, [effects]);

  const handleComplete = (id: string) => {
    setActiveEffects(prev => prev.filter(e => e.id !== id));
    onEffectComplete?.(id);
  };

  return (
    <group>
      {activeEffects.map((effect) => (
        <SingleHitEffect key={effect.id} effect={effect} onComplete={handleComplete} />
      ))}
    </group>
  );
}
